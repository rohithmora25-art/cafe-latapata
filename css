:root{--bg:#fff;--card:#fff;--ink:#2b2724;--brown:#6b4a35;--gold:#b89a62;--line:#eee8dd;--soft:#f8f5ef;color-scheme:light}

*{box-sizing:border-box}html{scroll-behavior:smooth;scroll-padding-top:76px}
body{margin:0;background:var(--bg);color:var(--ink);font:400 16px/1.55 Inter,system-ui,sans-serif;padding-top:env(safe-area-inset-top,0px)}
h1,h2,h3{font-family:'Cormorant Garamond',Georgia,serif;font-weight:600;margin:0;line-height:1.1}
.script{font-family:'Great Vibes',cursive;font-weight:400}
section{padding:72px 20px;max-width:1180px;margin:auto}
.eyebrow{color:var(--gold);letter-spacing:.2em;text-transform:uppercase;font-size:12px}
h2{font-size:clamp(30px,5vw,46px);margin:6px 0 24px}
.btn{border:0;border-radius:999px;padding:12px 22px;font:500 15px Inter;cursor:pointer;background:var(--brown);color:#fff;transition:.25s;min-height:44px}
.btn:hover{transform:translateY(-2px);box-shadow:0 8px 20px #0002}.btn.ghost{background:transparent;color:var(--brown);border:1px solid var(--gold)}
.btn[disabled]{opacity:.5;cursor:not-allowed}
input,select,textarea{width:100%;padding:12px 14px;border-radius:12px;border:1px solid var(--line);background:var(--card);color:var(--ink);font:inherit;min-height:44px}
label{font-size:13px;color:var(--brown);display:block;margin:10px 0 4px}
#intro{position:fixed;inset:0;background:var(--bg);z-index:100;display:grid;place-items:center;transition:opacity .8s,visibility .8s}
#intro.gone{opacity:0;visibility:hidden}
#intro .logo{text-align:center;animation:rise 1.4s both}
#intro .logo .script{font-size:clamp(56px,14vw,110px);color:var(--brown)}
#intro .logo .script b{font-weight:400;color:var(--gold);font-size:1.45em;display:inline-block;animation:swash 1.6s .2s both}
@keyframes rise{from{opacity:0;transform:translateY(20px);filter:blur(6px)}}@keyframes swash{from{opacity:0;transform:scale(.4) rotate(-12deg)}}
nav{position:sticky;top:env(safe-area-inset-top,0px);z-index:50;background:color-mix(in srgb,var(--bg) 88%,transparent);backdrop-filter:blur(12px);border-bottom:1px solid var(--line)}
nav .in{max-width:1180px;margin:auto;padding:10px 20px;display:flex;align-items:center;gap:18px}
.brand{display:flex;align-items:center;gap:8px;font-size:30px;color:var(--brown);text-decoration:none;margin-right:auto}
.brand b{font-size:1.4em;color:var(--gold);font-weight:400}.brand svg{width:22px;height:22px}
nav a.l{color:var(--ink);text-decoration:none;font-size:14px;opacity:.8}nav a.l:hover{opacity:1;color:var(--gold)}
.links{display:flex;gap:18px;align-items:center}
.cartb{position:relative;background:none;border:0;font-size:22px;cursor:pointer;color:var(--ink);min-width:44px;min-height:44px}
.cartb i{position:absolute;top:2px;right:0;background:var(--gold);color:#fff;border-radius:99px;font:600 11px Inter;padding:1px 6px;font-style:normal}
.burger{display:none;background:none;border:0;width:44px;height:44px;cursor:pointer}
.burger span{display:block;height:2px;background:var(--ink);margin:6px 10px;transition:.3s}
.burger.open span:nth-child(1){transform:translateY(8px) rotate(45deg)}.burger.open span:nth-child(2){opacity:0}.burger.open span:nth-child(3){transform:translateY(-8px) rotate(-45deg)}
@media(max-width:860px){.burger{display:block}.links{position:fixed;top:60px;left:0;right:0;background:var(--bg);flex-direction:column;padding:20px;gap:18px;border-bottom:1px solid var(--line);transform:translateY(-130%);transition:.35s}.links.open{transform:none}}
.hero{display:grid;grid-template-columns:1.1fr 1fr;gap:40px;align-items:center;min-height:80vh}
.hero h1{font-size:clamp(40px,7vw,76px)}.hero h1 em{font-family:'Great Vibes';font-style:normal;color:var(--gold);font-weight:400}
.hero p{max-width:480px;color:var(--brown);font-size:18px}
.hero .cta{display:flex;gap:12px;flex-wrap:wrap;margin-top:22px}
.plate{position:relative;aspect-ratio:1;border-radius:50%;background:radial-gradient(circle at 35% 30%,#fff,var(--soft) 60%,#e6d6bd);box-shadow:0 30px 80px #6b4a3533;display:grid;place-items:center;font-size:clamp(90px,16vw,170px)}
.float{position:absolute;font-size:44px;animation:fl 5s ease-in-out infinite}.float:nth-child(2){top:6%;right:8%;animation-delay:-1s}.float:nth-child(3){bottom:8%;left:2%;animation-delay:-2.5s}.float:nth-child(4){bottom:14%;right:0;animation-delay:-3.5s}
@keyframes fl{50%{transform:translateY(-14px) rotate(6deg)}}
@media(max-width:860px){.hero{grid-template-columns:1fr;min-height:auto;padding-top:30px}.plate{max-width:340px;margin:auto}}
.tools{display:flex;gap:10px;flex-wrap:wrap;margin-bottom:14px}.tools input{flex:1;min-width:200px}.tools select{width:auto}
.chips{display:flex;gap:8px;overflow-x:auto;padding-bottom:10px;margin-bottom:18px}
.chip{flex:none;border:1px solid var(--line);background:var(--card);color:var(--ink);border-radius:99px;padding:9px 16px;cursor:pointer;font:500 14px Inter;min-height:44px}
.chip.on{background:var(--brown);color:#fff;border-color:var(--brown)}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(250px,1fr));gap:20px}
.card{background:var(--card);border:1px solid var(--line);border-radius:22px;overflow:hidden;transition:.3s;animation:fade .5s both;display:flex;flex-direction:column}
.card:hover{transform:translateY(-5px);box-shadow:0 18px 40px #6b4a3522}
@keyframes fade{from{opacity:0;transform:translateY(12px)}}
.img{aspect-ratio:4/3;display:grid;place-items:center;font-size:64px;position:relative;cursor:pointer}
.img svg{width:100%;height:100%;display:block}.ci .t{position:relative;overflow:hidden}.ci .t svg{width:100%;height:100%}.badge{position:absolute;top:10px;left:10px;background:#fffd;color:var(--brown);font:600 11px Inter;padding:4px 10px;border-radius:99px;letter-spacing:.05em}
.dot{position:absolute;top:10px;right:10px;width:16px;height:16px;border:2px solid #2e8b57;border-radius:3px;background:#fff;display:grid;place-items:center}.dot:after{content:'';width:7px;height:7px;border-radius:50%;background:#2e8b57}.dot.nv{border-color:#b3261e}.dot.nv:after{background:#b3261e}
.cb{padding:14px 16px 16px;display:flex;flex-direction:column;gap:6px;flex:1}.cb h3{font-size:22px}.cb p{margin:0;font-size:13.5px;opacity:.75;flex:1}
.row{display:flex;justify-content:space-between;align-items:center;gap:8px}.price{font:600 20px 'Cormorant Garamond';color:var(--brown)}
.qty{display:inline-flex;align-items:center;gap:10px;background:var(--soft);border-radius:99px;padding:2px}.qty button{width:36px;height:36px;border:0;border-radius:50%;background:var(--card);color:var(--ink);cursor:pointer;font-size:18px}
.link{background:none;border:0;color:var(--gold);cursor:pointer;font:500 13px Inter;padding:6px 0;text-decoration:underline}
.grid3{display:grid;grid-template-columns:repeat(auto-fit,minmax(210px,1fr));gap:18px}
.feat{background:var(--card);border:1px solid var(--line);border-radius:20px;padding:22px}.feat div{font-size:30px}.feat h3{font-size:22px;margin:8px 0 4px}.feat p{margin:0;font-size:14px;opacity:.75}
.demo{font-size:12px;color:var(--gold);border:1px dashed var(--gold);display:inline-block;padding:2px 10px;border-radius:99px;margin-bottom:10px}
.panel{background:var(--card);border:1px solid var(--line);border-radius:24px;padding:24px;max-width:640px}
.two{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.steps{display:flex;gap:6px;margin:16px 0}.steps div{flex:1;text-align:center;font-size:12px;opacity:.45}.steps div:before{content:'';display:block;height:6px;border-radius:9px;background:var(--line);margin-bottom:6px}.steps .on{opacity:1}.steps .on:before{background:var(--gold)}
.ov{position:fixed;inset:0;background:#0007;z-index:80;display:none;align-items:center;justify-content:center;padding:16px;backdrop-filter:blur(3px)}.ov.show{display:flex;animation:fade .3s}
.modal{background:var(--bg);border-radius:26px;max-width:720px;width:100%;max-height:92vh;overflow:auto;position:relative}
.modal .img{aspect-ratio:16/8;font-size:90px}.mb{padding:22px}.x{position:absolute;top:12px;right:12px;z-index:2;width:40px;height:40px;border:0;border-radius:50%;background:#fffd;cursor:pointer;font-size:18px;color:#222}
.drawer{position:fixed;top:0;right:0;bottom:0;width:min(420px,100%);background:var(--bg);z-index:90;transform:translateX(105%);transition:.4s;display:flex;flex-direction:column;padding:calc(18px + env(safe-area-inset-top,0px)) 18px calc(18px + env(safe-area-inset-bottom,0px));box-shadow:-20px 0 60px #0003}.drawer.show{transform:none}
.ci{display:flex;gap:12px;align-items:center;padding:12px 0;border-bottom:1px solid var(--line)}.ci .t{width:48px;height:48px;border-radius:12px;display:grid;place-items:center;font-size:26px}
.sum div{display:flex;justify-content:space-between;padding:3px 0;font-size:14px}.sum .tot{font-weight:600;font-size:18px;border-top:1px solid var(--line);margin-top:6px;padding-top:8px}
.toast{position:fixed;left:50%;bottom:calc(24px + env(safe-area-inset-bottom,0px));transform:translate(-50%,40px);background:var(--ink);color:var(--bg);padding:12px 20px;border-radius:99px;z-index:120;opacity:0;transition:.35s;font-size:14px;max-width:90vw}.toast.show{opacity:1;transform:translate(-50%,0)}
.wa{position:fixed;right:16px;bottom:calc(16px + env(safe-area-inset-bottom,0px));width:54px;height:54px;border-radius:50%;background:#25d366;color:#fff;display:grid;place-items:center;font-size:26px;text-decoration:none;z-index:60;box-shadow:0 8px 24px #0003}
footer{background:var(--soft);border-top:1px solid var(--line);padding:50px 20px calc(30px + env(safe-area-inset-bottom,0px))}
footer .g{max-width:1180px;margin:auto;display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:28px;font-size:14px}footer h4{margin:0 0 8px;font-family:'Cormorant Garamond';font-size:20px}footer a{color:var(--ink);opacity:.75;display:block;text-decoration:none;padding:2px 0}
.reveal{opacity:0;transform:translateY(24px);transition:.8s}.reveal.in{opacity:1;transform:none}
table{width:100%;border-collapse:collapse;font-size:14px}td,th{padding:8px;border-bottom:1px solid var(--line);text-align:left}
.scroll{overflow-x:auto}.empty{text-align:center;padding:40px;opacity:.6}
@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}
